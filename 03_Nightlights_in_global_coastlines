// Filter coastal regions
// Import a coastline
var coast = ee.FeatureCollection('projects/UQ_intertidal/dataMasks/naturalEarthCoastline_v1');
//Map.addLayer(coast, {color:'yellow'}, 'coast');

// Create coastal ecoregion variable using fiter
var coastRegions = grid5.filter(ee.Filter.bounds(coast));
//Map.addLayer(coastRegions, {color: 'blue'}, 'Coastal regions');


// Selected area
var geometry = 
    /* color: #98ff00 */
    /* displayProperties: [
      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[116.4843896255338, 31.42735150558676],
          [116.4843896255338, 23.159150070934786],
          [127.2949365005338, 23.159150070934786],
          [127.2949365005338, 31.42735150558676]]], null, false);
// Filter ecoregions to bounds
var coast_ecoregions = grid5
.filter(ee.Filter.bounds(coast))
//.filter(ee.Filter.bounds(geometry)); // let's limit it for testing
//Map.addLayer(coast_ecoregions, {color:'firebrick'}, 'coastal ecoregions');

// Calculate population change between 2000 and 2015
var pop_change = population_2015
  .subtract(population_2000)
  .clip(coast_ecoregions);
//Map.addLayer (pop_changePerEcoregion, {palette:  ['red', 'black', 'lime'], min: -500, max: 500}, 'pop_change', true, 0.9);

// Calculate nightlight change between 2000 and 2013
var nl_change = nl_2013_avg
  .subtract(nl_2000_avg)
  .clip(coast_ecoregions);
//Map.addLayer (nl_change, {palette:  ['red', 'black', 'lime'], min: -50, max: 50}, 'nl_change', true, 0.9);


// Compute the average change
// average change in population per ecoregion
var pop_changePerGrid = pop_change.reduceRegions({
  collection: coast_ecoregions, 
  reducer: ee.Reducer.mean(), 
  scale: 1000, // note computing at a larger scale for speed
});
print (pop_changePerGrid.first()); // look at properties of the first one

// average change in nightlights per ecoregion
var nl_changePerGrid = nl_change.reduceRegions({
  collection: coast_ecoregions, 
  reducer: ee.Reducer.mean(), 
  scale: 1000, // note computing at a larger scale for speed
});
print (nl_changePerGrid.first()); // look at properties of the first one

